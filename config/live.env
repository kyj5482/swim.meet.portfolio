# SwimVault — 운영(Live) 환경 설정 (템플릿)
# scripts/run.sh live 가 이 파일을 source 한다.
# ⚠ 실제 비밀값은 절대 커밋하지 말 것. 배포 시 시크릿 매니저/CI 변수로 주입한다.
#   (이 파일은 구조/기본값 템플릿. 비밀은 환경에서 오버라이드.)

SWIMVAULT_ENV=live
NODE_ENV=production

# 운영 비밀 — 환경/시크릿 매니저에서 주입 (여기 값은 자리표시자)
JWT_SECRET=${JWT_SECRET:-CHANGE_ME_IN_SECRET_MANAGER}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}

# 운영 포트 (단일 인스턴스 기동 시. 컨테이너/오케스트레이터에서 오버라이드 가능)
GATEWAY_PORT=8080
AUTH_PORT=8081
ATHLETE_PORT=8082
INGESTION_PORT=8083
EXTRACTION_PORT=8084
RECORDS_PORT=8085
STANDARDS_PORT=8086
ANALYTICS_PORT=8087
GAMIFICATION_PORT=8088
FAMILY_PORT=8089
FRONTEND_PORT=5173

# 게이트웨이 → 내부 서비스 (운영 도메인/클러스터 DNS로 교체)
AUTH_SERVICE_URL=${AUTH_SERVICE_URL:-http://auth-service:8081}
ATHLETE_SERVICE_URL=${ATHLETE_SERVICE_URL:-http://athlete-service:8082}
INGESTION_SERVICE_URL=${INGESTION_SERVICE_URL:-http://ingestion-service:8083}
EXTRACTION_SERVICE_URL=${EXTRACTION_SERVICE_URL:-http://extraction-service:8084}
RECORDS_SERVICE_URL=${RECORDS_SERVICE_URL:-http://records-service:8085}
STANDARDS_SERVICE_URL=${STANDARDS_SERVICE_URL:-http://standards-service:8086}
ANALYTICS_SERVICE_URL=${ANALYTICS_SERVICE_URL:-http://analytics-service:8087}
GAMIFICATION_SERVICE_URL=${GAMIFICATION_SERVICE_URL:-http://gamification-service:8088}
FAMILY_SERVICE_URL=${FAMILY_SERVICE_URL:-http://family-service:8089}

# 프론트엔드가 호출할 게이트웨이 베이스 (운영 도메인)
VITE_API_BASE=${VITE_API_BASE:-https://api.swimvault.app}
# 운영은 실서버 데이터 사용
VITE_USE_MOCK=false

LOG_LEVEL=info
