# SwimVault — 개발(Dev) 환경 설정
# scripts/run.sh dev 가 이 파일을 source 한다. 로컬에서 모든 서비스를 직접 기동.

SWIMVAULT_ENV=dev
NODE_ENV=development

# 토큰 서명 (auth-service / api-gateway 공유). 운영에서는 반드시 교체.
JWT_SECRET=dev-secret

# LLM 키 — extraction-service에만 사용 (R5). 비우면 결정적 mock 추출로 동작.
ANTHROPIC_API_KEY=

# 서비스 포트 (로컬 직접 기동)
GATEWAY_PORT=8080
AUTH_PORT=8081
ATHLETE_PORT=8082
INGESTION_PORT=8083
EXTRACTION_PORT=8084
RECORDS_PORT=8085
STANDARDS_PORT=8086
ANALYTICS_PORT=8087
GAMIFICATION_PORT=8088
FAMILY_PORT=8089
FRONTEND_PORT=5173

# 게이트웨이 → 내부 서비스 디스커버리 (로컬 = localhost)
AUTH_SERVICE_URL=http://localhost:8081
ATHLETE_SERVICE_URL=http://localhost:8082
INGESTION_SERVICE_URL=http://localhost:8083
EXTRACTION_SERVICE_URL=http://localhost:8084
RECORDS_SERVICE_URL=http://localhost:8085
STANDARDS_SERVICE_URL=http://localhost:8086
ANALYTICS_SERVICE_URL=http://localhost:8087
GAMIFICATION_SERVICE_URL=http://localhost:8088
FAMILY_SERVICE_URL=http://localhost:8089

# 프론트엔드가 호출할 게이트웨이 베이스
VITE_API_BASE=http://localhost:8080
# 게이트웨이 실프록시 전까지 프론트는 시드(mock)로 자립 렌더. 실서버 붙으면 false.
VITE_USE_MOCK=true

# 로그 레벨 (gateway 접근 로그 등)
LOG_LEVEL=debug
